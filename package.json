{
  "name": "@conarti/eslint-plugin-feature-sliced",
  "type": "module",
  "version": "2.0.0-rc.16",
  "description": "Feature-sliced design methodology plugin",
  "author": "Aleksandr Belous <abelous2009@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conarti/eslint-plugin-feature-sliced.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "feature-sliced",
    "feature-slices",
    "feature-driven",
    "feature-based"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "tsup --format esm,cjs --clean --dts",
    "prepack": "npm run build",
    "prepare": "patch-package",
    "stub": "tsup --format esm",
    "dev": "npx @eslint/config-inspector --config eslint.config.ts",
    "watch": "tsup --format esm,cjs --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "test": "vitest",
    "test:ui": "vitest --ui --api 9527",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run --incremental",
    "smoke": "node scripts/smoke.mjs",
    "publish:patch": "npm version patch && npm publish",
    "publish:minor": "npm version minor && npm publish",
    "publish:major": "npm version major && npm publish",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "local-build": "node scripts/local-build.js",
    "release": "node scripts/release.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.45.0",
    "eslint-plugin-import-x": "^4.16.1",
    "picomatch": "^2.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.7.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.20.2",
    "@types/picomatch": "^2.3.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@typescript-eslint/rule-tester": "^8.45.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "conventional-changelog-cli": "^2.2.2",
    "eslint": "^9.11.1",
    "execa": "5.1.1",
    "knip": "^6.36.0",
    "patch-package": "^8.0.1",
    "picocolors": "^1.0.0",
    "prompts": "^2.4.2",
    "rimraf": "^5.0.1",
    "semantic-release": "^24.2.0",
    "semver": "^7.5.4",
    "tsup": "^8.5.0",
    "typescript": "^5.6.2",
    "vitepress": "^1.0.0-alpha.64",
    "vitest": "^5.0.1"
  }
}
